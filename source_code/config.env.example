# ==============================================================
#  منصة حجز القاعات — ملف الإعدادات (config.env)
#  يُنسخ تلقائياً إلى مجلد المنظومة الرئيسي عند أول تشغيل للوحة التحكم.
#  بعد أي تعديل: أعد تشغيل المنظومة (الخيار 10 في لوحة التحكم).
# ==============================================================

# منفذ التشغيل
PORT=5050

# المنطقة الزمنية (تُستخدم في مواعيد الحجوزات والتذكيرات)
TZ=Asia/Baghdad

# قاعدة البيانات: pglite = مدمجة داخل المنظومة (لا تحتاج تنصيب PostgreSQL)
#                 postgres = خادم PostgreSQL خارجي (يتطلب DATABASE_URL)
DB_DRIVER=pglite
# DATABASE_URL=postgres://user:password@localhost:5432/hall_booking

# مدة الجلسة (ساعات) ومهلة الخمول (دقائق) قبل تسجيل الخروج التلقائي
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# قفل الحساب بعد عدد محاولات دخول فاشلة، ومدة القفل بالدقائق
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# فعّلها (1) فقط إذا كان النظام خلف Reverse Proxy مثل IIS أو Nginx
TRUST_PROXY=0

# مستوى السجلات: info | warn | error | debug
LOG_LEVEL=info
