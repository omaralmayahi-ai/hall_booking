{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter @workspace/hall-booking run build && pnpm --filter @workspace/api-server run build",
    "start": "node artifacts/api-server/dist/index.mjs",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/hall-booking run dev",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5"
  }
}